<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <RootNamespace>StemmaGraph.Samples.AotSmoke</RootNamespace>
    <Description>
      03-AotSmoke: minimal linear graph published with Native AOT (PublishAot).
    </Description>
    <!-- Opt-in publish: dotnet publish -c Release -p:PublishAot=true -->
    <PublishAot>true</PublishAot>
    <InvariantGlobalization>true</InvariantGlobalization>
    <TrimMode>full</TrimMode>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\StemmaGraph\StemmaGraph.csproj" />
  </ItemGroup>

</Project>
