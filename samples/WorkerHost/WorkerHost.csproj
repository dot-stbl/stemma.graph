<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>Voluta.Samples.WorkerHost</RootNamespace>
    <IsPackable>false</IsPackable>
    <Description>
      WorkerHost: durable BackgroundService runner — wake by threadId, run until interrupt/done/fail.
      Uses Voluta.Hosting presets (IThreadWakeBus + GraphWorkerService).
    </Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\core\Voluta\Voluta.csproj" />
    <ProjectReference Include="..\..\src\core\Voluta.DependencyInjection\Voluta.DependencyInjection.csproj" />
    <ProjectReference Include="..\..\src\hosting\Voluta.Hosting\Voluta.Hosting.csproj" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.*" />
  </ItemGroup>

</Project>
