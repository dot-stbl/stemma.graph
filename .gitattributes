# =====================================================================
# .gitattributes — нормализация line endings
# =====================================================================
# editorconfig требует end_of_line = lf; на Windows-разработчикам
# нужно явно попросить git не подставлять CRLF при checkout.
#
# На Windows-машинах выполнить один раз:
#   git config --global core.autocrlf input
# =====================================================================

# По умолчанию — авто-определение с нормализацией в LF
* text=auto eol=lf

# Явно текстовые
*.cs        text eol=lf
*.csproj    text eol=lf
*.slnx      text eol=lf
*.sln       text eol=lf
*.props     text eol=lf
*.targets   text eol=lf
*.json      text eol=lf
*.yml       text eol=lf
*.yaml      text eol=lf
*.xml       text eol=lf
*.md        text eol=lf
*.sh        text eol=lf
.editorconfig text eol=lf
.gitattributes text eol=lf
.gitignore   text eol=lf

# Скрипты Windows — оставляем CRLF
*.bat       text eol=crlf
*.cmd       text eol=crlf
*.ps1       text eol=crlf

# Бинарники
*.dll       binary
*.exe       binary
*.pdb       binary
*.png       binary
*.jpg       binary
*.jpeg      binary
*.gif       binary
*.ico       binary
*.pdf       binary
*.zip       binary