<Project>

    <!-- Shared MSBuild defaults for all StemmaGraph packages.
         The nearest Directory.Build.props for every project under src/. -->

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <LangVersion>latest</LangVersion>

        <!-- Warnings as errors — clean build = rules pass. -->
        <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
        <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>

        <!-- XML docs required on public API, enforced via CS1591. -->
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <NoWarn>$(NoWarn);CS1591</NoWarn>

        <!-- OSS metadata — applied to every produced package. -->
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
        <Authors>Stemma contributors</Authors>
        <PackageProjectUrl>https://github.com/dot-stbl/stemma.graph</PackageProjectUrl>
        <RepositoryUrl>https://github.com/dot-stbl/stemma.graph</RepositoryUrl>
        <RepositoryType>git</RepositoryType>
        <PackageTags>agents;stateful-graphs;workflows;checkpointing;dotnet</PackageTags>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <PackageIcon>package-icon.png</PackageIcon>
        <Copyright>Copyright (c) Stemma contributors</Copyright>
        <PublishRepositoryUrl>true</PublishRepositoryUrl>
        <EmbedUntrackedSources>true</EmbedUntrackedSources>

        <!-- Globally suppressed warnings (with documented reason) -->
        <!-- NU1903 — Testcontainers.PostgreSql pulls SSH.NET 2024.1.0 which has
             GHSA-q939-rpr3-3284 (transitive dep of Testcontainers, not our code).
             Tracked separately — bump Testcontainers when an upstream fix lands. -->
        <NoWarn>$(NoWarn);NU1903</NoWarn>
    </PropertyGroup>

    <!-- Source-link + deterministic builds. -->
    <ItemGroup>
        <PackageReference Include="Microsoft.SourceLink.GitHub" Version="8.0.0">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
        <PackageReference Include="Microsoft.VisualStudio.Threading.Analyzers" Version="17.14.15">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
    </ItemGroup>

    <!-- NuGet package assets (icon + readme) for all packable library projects. -->
    <ItemGroup Condition="'$(IsPackable)' != 'false'">
        <None Include="$(MSBuildThisFileDirectory)assets\package-icon.png"
              Pack="true"
              PackagePath="package-icon.png"
              Visible="false"
              Condition="Exists('$(MSBuildThisFileDirectory)assets\package-icon.png')" />
        <None Include="$(MSBuildThisFileDirectory)README.md"
              Pack="true"
              PackagePath="README.md"
              Visible="false"
              Condition="Exists('$(MSBuildThisFileDirectory)README.md')" />
    </ItemGroup>

</Project>