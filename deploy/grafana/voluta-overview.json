      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "editorMode": "code",
          "expr": "sum(increase(voluta_checkpoint_put_count_total{job=~\"$job\"}[$__range]))",
          "legendFormat": "puts",
          "range": true,
          "refId": "A"
        }
