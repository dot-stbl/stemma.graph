<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Roslyn analyzers/generators must target netstandard2.0. -->
    <TargetFramework>netstandard2.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
    <IsRoslynComponent>true</IsRoslynComponent>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <DevelopmentDependency>true</DevelopmentDependency>
    <IsPackable>true</IsPackable>
    <SuppressDependenciesWhenPacking>true</SuppressDependenciesWhenPacking>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);RS2008;NU5128</NoWarn>
    <Description>
      Optional Roslyn source generator: [GraphState] → Schema + Update + ToWrites.
      Not required to compile or run the Voluta runtime.
    </Description>
    <PackageTags>$(PackageTags);source-generator;roslyn;graph-state</PackageTags>
    <IncludeSymbols>false</IncludeSymbols>
    <PublishRepositoryUrl>false</PublishRepositoryUrl>
    <EmbedUntrackedSources>false</EmbedUntrackedSources>
    <EnableSourceLink>false</EnableSourceLink>
    <EnableSourceControlManagerQueries>false</EnableSourceControlManagerQueries>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.11.0" PrivateAssets="all" />
    <PackageReference Include="Microsoft.CodeAnalysis.Analyzers" Version="3.11.0" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Remove="Microsoft.SourceLink.GitHub" />
  </ItemGroup>

  <!-- Analyzer DLL into nupkg. Avoid DependsOnTargets Build (breaks no-build pack smoke). -->
  <Target Name="AddAnalyzerToPackage" BeforeTargets="_GetPackageFiles">
    <PropertyGroup>
      <_AnalyzerDll Condition="'$(TargetPath)' != '' and Exists('$(TargetPath)')">$(TargetPath)</_AnalyzerDll>
      <_AnalyzerDll Condition="'$(_AnalyzerDll)' == '' and Exists('$(MSBuildProjectDirectory)\$(OutputPath)$(AssemblyName).dll')">$(MSBuildProjectDirectory)\$(OutputPath)$(AssemblyName).dll</_AnalyzerDll>
    </PropertyGroup>
    <Error
      Condition="'$(_AnalyzerDll)' == ''"
      Text="Voluta.Generators: analyzer DLL not found for pack. Build the project before packing." />
    <ItemGroup>
      <None Include="$(_AnalyzerDll)" Pack="true" PackagePath="analyzers/dotnet/cs" Visible="false" />
    </ItemGroup>
  </Target>

</Project>
