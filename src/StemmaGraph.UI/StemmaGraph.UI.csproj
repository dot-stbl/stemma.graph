<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Description>
      Ops console for StemmaGraph: run inspector, HITL queue, topology (MD3 static UI + MapStemmaUI).
    </Description>
    <PackageTags>$(PackageTags);ui;inspector;hitl</PackageTags>
    <RootNamespace>StemmaGraph.UI</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <ProjectReference Include="..\StemmaGraph\StemmaGraph.csproj" />
    <ProjectReference Include="..\StemmaGraph.Abstractions\StemmaGraph.Abstractions.csproj" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="wwwroot\index.html" LogicalName="StemmaGraph.UI.wwwroot.index.html" />
    <EmbeddedResource Include="wwwroot\styles.css" LogicalName="StemmaGraph.UI.wwwroot.styles.css" />
  </ItemGroup>

</Project>
