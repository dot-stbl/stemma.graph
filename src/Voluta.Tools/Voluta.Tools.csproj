<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Description>
      Tool-calling batteries for Voluta graphs without an LLM SDK:
      ITool / ToolGraphNode (invoke + channel write + optional timeout) and
      a light MCP HTTP client adapter (list tools / call tool).
    </Description>
    <PackageTags>$(PackageTags);tools;mcp;agents</PackageTags>
    <RootNamespace>Voluta.Tools</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Voluta\Voluta.csproj" />
  </ItemGroup>

</Project>
