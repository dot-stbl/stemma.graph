<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Description>
      Provider-agnostic EF Core C-shape checkpointer for Voluta.
      Consumers register their own EF database provider (Npgsql, SqlServer, SQLite, …).
    </Description>
    <PackageTags>$(PackageTags);checkpoint;efcore;persistence</PackageTags>
    <RootNamespace>Voluta.Checkpoints.EntityFrameworkCore</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.*" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.*" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.*" />
    <ProjectReference Include="..\..\core\Voluta.Abstractions\Voluta.Abstractions.csproj" />
    <ProjectReference Include="..\..\core\Voluta.DependencyInjection\Voluta.DependencyInjection.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Voluta.Checkpoints.EntityFrameworkCore.Unit" />
  </ItemGroup>

</Project>
