<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Description>
      Redis C-shape checkpointer for Voluta (sorted-set per thread, wire format v1).
    </Description>
    <PackageTags>$(PackageTags);checkpoint;redis;persistence</PackageTags>
    <RootNamespace>Voluta.Checkpoints.Redis</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.*" />
    <PackageReference Include="StackExchange.Redis" Version="2.8.*" />
    <ProjectReference Include="..\..\core\Voluta.Abstractions\Voluta.Abstractions.csproj" />
    <ProjectReference Include="..\..\core\Voluta.DependencyInjection\Voluta.DependencyInjection.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Voluta.Checkpoints.Redis.Unit" />
  </ItemGroup>

</Project>
