<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Description>
      File-system C-shape checkpointer for Voluta (JSON per thread under a root directory).
    </Description>
    <PackageTags>$(PackageTags);checkpoint;file;persistence</PackageTags>
    <RootNamespace>Voluta.Checkpoints.File</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.*" />
    <ProjectReference Include="..\..\core\Voluta.Abstractions\Voluta.Abstractions.csproj" />
    <ProjectReference Include="..\..\core\Voluta.DependencyInjection\Voluta.DependencyInjection.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Voluta.Checkpoints.File.Unit" />
  </ItemGroup>

</Project>
