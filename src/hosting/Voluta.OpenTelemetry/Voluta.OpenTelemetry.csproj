<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Description>
      OpenTelemetry instrumentation for Voluta: AddVolutaInstrumentation() for
      TracerProviderBuilder and MeterProviderBuilder. Core Voluta emits BCL
      ActivitySource/Meter only; this package registers them with the OTel SDK.
    </Description>
    <PackageTags>$(PackageTags);opentelemetry;otel;tracing;metrics;observability</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\core\Voluta\Voluta.csproj" />
    <PackageReference Include="OpenTelemetry.Api.ProviderBuilderExtensions" Version="1.17.0" />
  </ItemGroup>

</Project>
