<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Description>
      Hosting presets for Voluta workers: IThreadWakeBus, in-memory Channel bus,
      GraphThreadRunner, and GraphWorkerService (BackgroundService drain loop).
    </Description>
    <PackageTags>$(PackageTags);hosting;worker;wake;background-service</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\core\Voluta\Voluta.csproj" />
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" Version="10.0.*" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.*" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.*" />
  </ItemGroup>

</Project>
