<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Description>
      The StemmaGraph runtime: Pregel-style superstep execution over a
      user-defined graph of nodes and edges, with channels, reducers,
      conditional edges, interrupts, and streaming output.
    </Description>
    <PackageTags>$(PackageTags);runtime;pregel;stateful</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <!-- This package owns the runtime and depends on the abstractions only. -->
    <ProjectReference Include="..\StemmaGraph.Abstractions\StemmaGraph.Abstractions.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.*" />
  </ItemGroup>

</Project>